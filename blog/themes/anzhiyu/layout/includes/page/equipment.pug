#equipment
  if site.data.equipment
    each i in site.data.equipment
      .author-content.author-content-item.fcirclePage.single(style = `background: url(${i.top_background}) left 37% / cover no-repeat !important;`)
        .card-content
          .author-content-item-tips
            span(data-bilingual-lang="en")=i.class_name
            span(data-bilingual-lang="zh")=i.class_name_zh || i.class_name
          span.author-content-item-title
            span(data-bilingual-lang="en")=i.description
            span(data-bilingual-lang="zh")=i.description_zh || i.description
          .content-bottom
            .tips
              span(data-bilingual-lang="en")=i.tip
              span(data-bilingual-lang="zh")=i.tip_zh || i.tip
      each item in i.good_things
        .goodthings-item
          h2.goodthings-title
            span(data-bilingual-lang="en")= item.title
            span(data-bilingual-lang="zh")= item.title_zh || item.title
          .goodthings-item-description
            span(data-bilingual-lang="en")= item.description
            span(data-bilingual-lang="zh")= item.description_zh || item.description
          .equipment-item
            .equipment-item-content
              each iten, indey in item.equipment_list
                .equipment-item-content-item
                  .equipment-item-content-item-cover
                    img.equipment-item-content-item-image(data-lazy-src=url_for(iten.image) onerror=`this.onerror=null;this.src='` + url_for(theme.error_img.flink) + `'` alt=iten.name)
                  .equipment-item-content-item-info
                    .equipment-item-content-item-name(onclick=`rm.rightmenuCopyText("${iten.name}");anzhiyu.snackbarShow("${_p('Snackbar.copy_equipment_name') + " 【" + iten.name + "】"}");` title=iten.name)= iten.name
                    .equipment-item-content-item-specification
                      span(data-bilingual-lang="en")= iten.specification
                      span(data-bilingual-lang="zh")= iten.specification_zh || iten.specification
                    .equipment-item-content-item-description
                      span(data-bilingual-lang="en")= iten.description
                      span(data-bilingual-lang="zh")= iten.description_zh || iten.description
                    .equipment-item-content-item-toolbar
                      if iten.link.includes('https://') || iten.link.includes('http://')
                        a.equipment-item-content-item-link(href= iten.link, target='_blank')
                          span(data-bilingual-lang="en") View
                          span(data-bilingual-lang="zh") 查看
                      else  
                        a.equipment-item-content-item-link(href= iten.link, target='_blank')
                          span(data-bilingual-lang="en") View
                          span(data-bilingual-lang="zh") 查看
                      if iten.report
                        a.equipment-item-content-item-link.equipment-report-link(href= iten.report, target='_blank', rel='noopener')
                          i.anzhiyufont.anzhiyu-icon-file-lines
                          span(data-bilingual-lang="en") Report
                          span(data-bilingual-lang="zh") 报告
